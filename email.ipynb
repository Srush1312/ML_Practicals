# Set Algorithm as the index and plot performance metrics
comparison.set_index('Algorithm').plot(
    kind='bar',
    figsize=(9, 5)
)

# Add graph title and labels
plt.title("KNN vs SVM Performance Comparison")
plt.ylabel("Score")
plt.xlabel("Classification Algorithm")

# Set Y-axis limits
plt.ylim(0, 1.1)

# Display algorithm names horizontally
plt.xticks(rotation=0)

# Display legend and grid
plt.legend(loc='lower right')
plt.grid(axis='y')

# Display the comparison graph
plt.show()

# Compare accuracy scores of KNN and SVM
if knn_accuracy > svm_accuracy:
    print("KNN performs better than SVM.")

elif svm_accuracy > knn_accuracy:
    print("SVM performs better than KNN.")

else:
    print("Both algorithms have equal accuracy.")

# Display final accuracy of both models
print("\nKNN Accuracy:", round(knn_accuracy * 100, 2), "%")
print("SVM Accuracy:", round(svm_accuracy * 100, 2), "%")
