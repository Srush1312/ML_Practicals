# Remove unnecessary unnamed columns, if present
df = df.loc[:, ~df.columns.str.contains('^Unnamed')]

# Remove duplicate records
df = df.drop_duplicates()

# Separate input features by removing ID and target columns
X = df.drop(['Email No.', 'Prediction'], axis=1)

# Store the target column
y = df['Prediction']

# Display the shapes of features and target
print("Features Shape:", X.shape)
print("Target Shape:", y.shape)

# Display class distribution
print("\nClass Distribution:")
print(y.value_counts())

# Check missing values in input features
print("\nMissing Values:", X.isnull().sum().sum())
Features Shape: (5172, 3000)
Target Shape: (5172,)

